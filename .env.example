# Template for the main environment file. Copy to `.env` and fill in. Never commit `.env`.
# Grouped by WHERE each setting must be set. Values with # or spaces go in "double quotes".

# --- 1) Browser app → Render (Environment) and .env. Safe to expose (row-level security protects the data) ----------
# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_…) — NOT the secret key
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: demo sign-in helpers on the live site (1 = on)
# VITE_DEMO=1

# --- 2) Live server (server.mjs) → Render (Environment) and .env: login codes, reset links, client emails -----------
NODE_VERSION=22
PORT=5180
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=no-reply@hr.rexera.in
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM="Rexera CRM" <no-reply@hr.rexera.in>
# Optional: send through Resend (HTTPS) when SMTP ports are blocked
# RESEND_API_KEY=
# RESEND_FROM="Rexera CRM" <no-reply@yourdomain.in>

# --- 2b) AI assistant (Rexy) → Render (Environment) and .env. Server-side only, never a VITE_ variable -------------
# Any OpenAI-compatible chat API. Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai · OpenAI: https://api.openai.com/v1 · OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
# Spend guards: questions per hour from one network, and per day for the whole server
AI_HOURLY_LIMIT=150
AI_DAILY_LIMIT=1500

# --- 3) Supabase Edge Function secrets → Supabase → Edge Functions → Secrets (not Render); also used by `npm run dev` --
# Click-to-Call credential from Blutec (key id btc_live_…, API key btc_key_…, signing secret c2csec_…)
# (BTC_KEY_ID / BTC_API_KEY / BTC_SIGNING_SECRET also work)
BLUTEC_KEY_ID=
BLUTEC_API_KEY=
BLUTEC_SIGNING_SECRET=
# Long-lived dialer API token (blt_…) — Do-Not-Disturb check before every call, and "Do not call" in the Dialer
BLUTEC_TOKEN=
# Dedicated Blutec IVR API user (never used to sign in to the Blutec website)
BLUTEC_IVR_EMAIL=
BLUTEC_IVR_PASSWORD=
# Optional: the base URLs your company uses (defaults shown)
# BLUTEC_DIALER_URL=https://dialer.blutec.ai
# BLUTEC_IVR_URL=https://ivr.blutec.ai

# --- 4) This computer only → never on Render or in the browser (data migration script) ------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret key (sb_secret_…): bypasses row-level security. Never put it in a VITE_ variable or browser code.
SUPABASE_SECRET_KEY=
