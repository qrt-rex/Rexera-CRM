# Copy to .env.local and fill in. Never commit .env.local.

# --- Server-side only (migration script, future API/Edge Functions) -----------------------------
# Project URL: Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret key (sb_secret_…): bypasses row-level security. Never put it in a VITE_ variable or browser code.
SUPABASE_SECRET_KEY=

# --- Browser (safe to expose; row-level security protects the data) ------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_…) — NOT the secret key
VITE_SUPABASE_PUBLISHABLE_KEY=
