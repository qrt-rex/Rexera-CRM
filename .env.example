# Copy to .env.local and fill in. Never commit .env.local.

# --- Server-side only (migration script, future API/Edge Functions) -----------------------------
# Project URL: Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret key (sb_secret_…): bypasses row-level security. Never put it in a VITE_ variable or browser code.
SUPABASE_SECRET_KEY=

# --- Blutec dialer + IVR (server-side only: the local dev relay and the Supabase `blutec` function) ----
# Click-to-Call credential from Blutec (key id btc_live_…, API key btc_key_…, signing secret c2csec_…)
# (BTC_KEY_ID / BTC_API_KEY / BTC_SIGNING_SECRET also work)
BLUTEC_KEY_ID=
BLUTEC_API_KEY=
BLUTEC_SIGNING_SECRET=
# Long-lived dialer API token (blt_…) — Do-Not-Disturb check before every call, and "Do not call" in the Dialer
BLUTEC_TOKEN=
# Dedicated Blutec IVR API user (never used to sign in to the Blutec website)
BLUTEC_IVR_EMAIL=
BLUTEC_IVR_PASSWORD=
# Optional: the base URLs your company uses (defaults shown)
# BLUTEC_DIALER_URL=https://dialer.blutec.ai
# BLUTEC_IVR_URL=https://ivr.blutec.ai

# --- Browser (safe to expose; row-level security protects the data) ------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_…) — NOT the secret key
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Live Production Server & SMTP Mail Delivery (Hostinger / custom SMTP) -----------------------
PORT=5180
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=no-reply@hr.rexera.in
# Note: If your password contains special characters like #, wrap it in quotes: "password#123"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM="Rexera CRM" <no-reply@hr.rexera.in>

